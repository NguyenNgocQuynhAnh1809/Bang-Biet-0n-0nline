rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gratitudes/{docId} {
      allow read: if true; // Giữ nguyên: Bất kỳ ai cũng có thể đọc.

      // Giữ nguyên quy tắc tạo mục mới của bạn
      allow create: if request.resource.data.keys().hasOnly([
        'text','emotionKey','emotionLabel','color','moodScore','createdAt','clientId','dateKey'
      ])
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 240
      && request.resource.data.emotionKey in ['bad','notgreat','okay','good','great']
      && request.time == request.resource.data.createdAt
      && docId == request.resource.data.clientId + '_' + request.resource.data.dateKey
      && !exists(/databases/$(database)/documents/gratitudes/$(docId));

      // QUY TẮC MỚI ĐÃ SỬA LỖI: Chỉ kiểm tra các trường không thay đổi
      allow update: if 
        // 1. Yêu cầu cập nhật chỉ được chứa trường 'comments'.
        request.writeFields.hasOnly(['comments'])
        // 2. Kiểm tra xem trường 'comments' được gửi lên có phải là một danh sách (List) hay không.
        && request.resource.data.comments is list;

      // Giữ nguyên: Không cho phép xóa
      allow delete: if false;
    }
  }
}
