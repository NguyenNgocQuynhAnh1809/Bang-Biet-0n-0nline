rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /gratitudes/{docId} {
      allow read: if true; // Giữ nguyên: Bất kỳ ai cũng có thể đọc.

      // Giữ nguyên quy tắc tạo mục mới của bạn
      allow create: if request.resource.data.keys().hasOnly([
        'text','emotionKey','emotionLabel','color','moodScore','createdAt','clientId','dateKey'
      ])
      && request.resource.data.text is string
      && request.resource.data.text.size() > 0
      && request.resource.data.text.size() <= 240
      && request.resource.data.emotionKey in ['bad','notgreat','okay','good','great']
      && request.time == request.resource.data.createdAt
      && docId == request.resource.data.clientId + '_' + request.resource.data.dateKey
      && !exists(/databases/$(database)/documents/gratitudes/$(docId));

      // QUY TẮC MỚI: Cho phép cập nhật để thêm bình luận
      allow update: if 
        // 1. Chỉ cho phép thêm hoặc thay đổi trường 'comments'.
        request.resource.data.keys().hasAll(resource.data.keys())
        && request.resource.data.keys().hasOnly(resource.data.keys().concat(['comments']))
        // 2. Đảm bảo các trường dữ liệu gốc không bị thay đổi.
        && request.resource.data.text == resource.data.text
        && request.resource.data.clientId == resource.data.clientId
        && request.resource.data.createdAt == resource.data.createdAt
        // 3. Xác thực dữ liệu của trường 'comments'.
        && request.resource.data.comments is list;
        // (Bạn có thể thêm các quy tắc xác thực chi tiết hơn cho từng bình luận nếu cần)

      // Vẫn không cho phép xóa
      allow delete: if false;
    }
  }
}
